# 环境变量配置文件
# 复制此文件为 .env 并根据实际环境修改配置

# ============================================
# TURN 服务配置
# ============================================

# TURN 服务器公网 IP 或域名
# 公网部署: 填写服务器的公网 IP 地址
# 局域网测试: 填写局域网 IP (如 192.168.1.20)
# 本地开发: 填写 127.0.0.1
TURN_PUBLIC_IP=127.0.0.1

# TURN UDP 监听地址 (默认: 0.0.0.0)
# TURN_LISTEN_ADDR=0.0.0.0

# TURN UDP 监听端口 (默认: 3478)
# TURN_PORT=3478

# TURN realm (默认: lead.remoteassist)
# TURN_REALM=lead.remoteassist

# TURN 用户名 (不能为空)
TURN_USERNAME=lead

# TURN 密码 (不能为空)
TURN_CREDENTIAL=leadpass

# TURN relay 端口范围 (默认: 0 表示不限制)
# 生产环境建议固定端口范围并在防火墙放行
# 两个参数必须同时为 0 或同时非 0
# TURN_MIN_PORT=50000
# TURN_MAX_PORT=50100

# 自定义 TURN ICE URL (可选)
# 仅影响客户端收到的 ICE 配置，不改变实际监听地址
# 默认值: turn:<TURN_PUBLIC_IP>:<TURN_PORT>
# TURN_URL=turn:custom.domain.com:3478

# ============================================
# HTTP 服务配置
# ============================================

# HTTP 监听地址 (默认: 0.0.0.0)
# HTTP_ADDR=0.0.0.0

# HTTP 监听端口 (默认: 8787)
# PORT=8787

# ============================================
# 鉴权与数据库
# ============================================

# SQLite 数据库路径 (默认: data/auth.db)
# 设为空字符串会禁用 SQLite 初始化和持久化
# AUTH_DB_PATH=data/auth.db

# 默认管理员 (admin) 的登录密码
# 生产环境务必修改此密码
ADMIN_PASSWORD=admin

# ============================================
# 高级配置 (可选)
# ============================================

# SFU 模式配置
# 配置后信令下发 relayMode=sfu 和对应 SFU 地址
# 为空时使用默认的 TURN 中继模式
# SFU_URL=wss://sfu.example.com/ws

# 自定义 ICE Servers JSON
# 完全自定义下发给客户端的 ICE servers
# 配置且解析成功时会替代默认 STUN 和内置 TURN
# 示例: [{"urls":"stun:stun.example.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
# ICE_SERVERS_JSON=
